<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:paddingTop="24dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="16dp"
        android:weightSum="1">

        <!-- Welcome Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, Admin"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UniLearn LMS Control Center"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Profile Image -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <!-- Profile Image -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_apple"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_profile_circle"
                android:contentDescription="Profile Picture" />

            <!-- Online Status Indicator -->
            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_online_status" />
        </FrameLayout>


    </LinearLayout>

    <!-- Quick Insights -->
    <TextView
        android:id="@+id/tvQuickInsights"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUICK INSIGHTS"
        android:textSize="10sp"
        android:textColor="@color/text_hint"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:layout_below="@id/headerLayout"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp" />

    <GridLayout
        android:id="@+id/gridQuickInsights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvQuickInsights"
        android:columnCount="2"
        android:rowCount="2"
        android:columnOrderPreserved="false"
        android:padding="16dp"
        >

    <!-- Students Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:clipToOutline="true"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"> <!-- optional for first column -->


        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:padding="1dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_students"
                        app:tint="@color/primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Students"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12,450"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Space
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+12%"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_status_label"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Teachers Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:clipToOutline="true"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"> <!-- optional for first column -->


        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:padding="1dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_teachers"
                        app:tint="@color/blue_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teachers"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="450"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Space
                    android:layout_width="70dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stable"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_status_label_blue"
                    android:textColor="@color/blue_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Courses Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:clipToOutline="true"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"> <!-- optional for first column -->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:padding="1dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_courses"
                         />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Courses"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="89"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Space
                    android:layout_width="90dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/bg_status_label_orange"
                    android:textColor="@color/orange_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Semester Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:clipToOutline="true"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"> <!-- optional for first column -->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:padding="1dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_semester"
                         />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semester"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fall 2023"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Space
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/primary"
                    android:layout_gravity="center_vertical"
                    android:clipToOutline="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:backgroundTint="@color/primary"
                    android:elevation="2dp"/>
            </LinearLayout>
        </LinearLayout>

    </GridLayout>


    <!-- Management Tools Grid -->
    <TextView
        android:id="@+id/tvManagementTools"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MANAGEMENT TOOLS"
        android:textSize="10sp"
        android:textColor="@color/text_hint"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:layout_below="@id/gridQuickInsights"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" />

    <!-- Grid of Action Buttons -->
    <GridLayout
        android:id="@+id/gridManagementTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvManagementTools"
        android:columnCount="2"
        android:rowCount="3"
        android:padding="20dp"
        >

        <!-- Manage Users -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:text="Manage\nUsers"
            app:icon="@drawable/ic_manage_users"
            style="@style/cardActionButton" />

        <!-- Manage Courses -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="10dp"
            android:text="Manage\nCourses"
            app:icon="@drawable/ic_manage_courses"
            style="@style/cardActionButton" />

        <!-- Create Announcements -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:text="Create\nAnnouncements"
            app:icon="@drawable/ic_create_announcement"
            style="@style/cardActionButton" />

        <!-- View Reports -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="View\nReports"
            app:icon="@drawable/ic_view_reports"
            style="@style/cardActionButton" />

        <!-- Semester Setup -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:text="Semester\nSetup"
            app:icon="@drawable/ic_semester_setup"
            style="@style/cardActionButton" />

        <!-- Timetable Management -->
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:text="Timetable\nManagement"
            app:icon="@drawable/ic_timetable_management"
            style="@style/cardActionButton" />

    </GridLayout>

    <!-- System Status Banner -->
    <LinearLayout
        android:id="@+id/systemStatusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/gridManagementTools"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/bg_status_banner"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cloud_done"
            android:layout_marginEnd="12dp"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Optimal"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All university servers are running normally."
                android:textSize="10sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETAILS"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="10sp"
            android:paddingStart="8dp"/>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        app:itemIconTint="@drawable/bottom_nav_selector"
        app:itemTextColor="@drawable/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_admin" />




