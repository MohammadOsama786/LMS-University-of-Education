    <style name="SegmentButton1">
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:textColor">@drawable/segment_text</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:button">@null</item> <!-- remove default radio circle -->
    </style>

